<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used only by the command-line archive/export path in README.md.
	     Distributing from Xcode's Organizer ignores this file entirely. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- Uncomment and set to your Team ID if xcodebuild can't infer it. -->
	<!--
	<key>teamID</key>
	<string>ABCDE12345</string>
	-->
</dict>
</plist>
